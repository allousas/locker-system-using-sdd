# Copy to .env for the pnpm db:* commands — dbmate is the only thing that reads this file.
# The app and the integration tests don't: both fall back to DEFAULT_DATABASE_URL in
# src/infrastructure/config/database.providers.ts, and nothing in src/ loads a .env.
# Matches docker-compose.yml. dbmate needs sslmode=disable against the local container.
DATABASE_URL=postgres://locker:locker@localhost:5433/locker?sslmode=disable
